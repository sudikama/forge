{
  "description": "forge: prompt triage, tool gate (locks, lane ownership, irreversible commands), small-harness driver, session banner; function-hook module (needs CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1): Jev compaction, auto-compact, Agent-tool subagent model routing",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/forge.mjs\" hook session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/forge.mjs\" hook prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/forge.mjs\" hook pretooluse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/forge.mjs\" hook stop",
            "timeout": 1800
          }
        ]
      }
    ]
  },
  "modules": [
    "./forge-fn.js"
  ]
}